import { Injectable, Logger } from '@nestjs/common';
import { DataSource } from 'typeorm';
import { Product } from './entities/product.entity';
import { StockReservationEntity } from './entities/stock-reservation.entity';
import { ReservationStatus } from './interfaces/reservation-status.enum';

export interface StockReserveItem {
  productId: number;
  quantity: number;
}

export interface StockReserveResult {
  success: boolean;
  reason?: string;
}

@Injectable()
export class StockService {
  private readonly logger = new Logger(StockService.name);

  constructor(private readonly dataSource: DataSource) {}

  /**
   * Reserves stock for an order, or fails cleanly with a reason.
   *
   * DEADLOCK PREVENTION: items are locked in ascending productId order,
   * ALWAYS -- regardless of the order the caller listed them in. Without
   * this, two concurrent multi-item orders reserving the same two
   * products in opposite order (order A: [X,Y], order B: [Y,X]) would
   * deadlock: A holds X waiting for Y, B holds Y waiting for X. InnoDB
   * detects and kills one transaction (safe -- the thrown exception now
   * correctly nacks via the caller), but it's an avoidable throughput
   * hit. Consistent lock ordering eliminates the circular wait entirely.
   */
  async reserve(orderId: number, items: StockReserveItem[]): Promise<StockReserveResult> {
    const sortedItems = [...items].sort((a, b) => a.productId - b.productId);

    return this.dataSource.transaction(async (manager) => {
      const reservationRepo = manager.getRepository(StockReservationEntity);
      const productRepo = manager.getRepository(Product);

      const existing = await reservationRepo.find({ where: { orderId } });
      if (existing.length > 0) {
        const anyStillReserved = existing.some((r) => r.status === ReservationStatus.RESERVED);
        this.logger.warn(`Duplicate stock.reserve for order ${orderId} -- returning recorded outcome`);
        return { success: anyStillReserved };
      }

      const lockedProducts = new Map<number, Product>();

      // Pass 1: lock + validate ALL items, in sorted order, before
      // writing anything. If any item fails here, nothing has been
      // written yet -- returning is safe (empty transaction, zero effect).
      for (const item of sortedItems) {
        const product = await productRepo.findOne({
          where: { id: item.productId },
          lock: { mode: 'pessimistic_write' },
        });

        if (!product) {
          return { success: false, reason: `PRODUCT_NOT_FOUND:${item.productId}` };
        }

        if (product.availableStock < item.quantity) {
          return { success: false, reason: `INSUFFICIENT_STOCK:${item.productId}` };
        }

        lockedProducts.set(item.productId, product);
      }

      // Pass 2: every item validated under lock -- apply reservations.
      for (const item of sortedItems) {
        const product = lockedProducts.get(item.productId)!;
        product.reservedStock += item.quantity;
        await productRepo.save(product);

        await reservationRepo.save(
          reservationRepo.create({
            orderId,
            productId: item.productId,
            quantity: item.quantity,
            status: ReservationStatus.RESERVED,
          }),
        );
      }

      return { success: true };
    });
  }

  /**
   * Releases whatever was reserved for an order, looked up from the
   * ledger. Same deadlock-prevention reasoning applies: reservations are
   * locked in ascending productId order via the query itself, not
   * whatever order they happened to be inserted in.
   */
  async release(orderId: number): Promise<void> {
    await this.dataSource.transaction(async (manager) => {
      const reservationRepo = manager.getRepository(StockReservationEntity);
      const productRepo = manager.getRepository(Product);

      const reservations = await reservationRepo.find({
        where: { orderId, status: ReservationStatus.RESERVED },
        order: { productId: 'ASC' },
      });

      if (reservations.length === 0) {
        this.logger.warn(
          `stock.release for order ${orderId}: no active reservations found (already released or never reserved)`,
        );
        return;
      }

      for (const reservation of reservations) {
        const product = await productRepo.findOne({
          where: { id: reservation.productId },
          lock: { mode: 'pessimistic_write' },
        });

        if (product) {
          product.reservedStock = Math.max(0, product.reservedStock - reservation.quantity);
          await productRepo.save(product);
        } else {
          this.logger.error(
            `stock.release for order ${orderId}: product ${reservation.productId} no longer exists`,
          );
        }

        reservation.status = ReservationStatus.RELEASED;
        await reservationRepo.save(reservation);
      }
    });
  }
}
